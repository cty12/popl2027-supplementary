(let* ([(power‶″ : (∀̇ (_ <: β <: _) (→ Int (→ (‶ Int ″ β) (‶ Int ″ β)))))
        (Λ (_ <: γ <: _)
          (fixλ p (n : Int) : (→ (‶ Int ″ γ) (‶ Int ″ γ))
            (λ (x : (‶ Int ″ γ))
               (if ('zero? n)
                   (‶ 1 ″ ε)
                   (‶ (('* ((~ x) :: Int))
                           ((~ ((p ('sub1 n)) x)) :: Int))
                    ″ γ)))))]
       [(r : (Ref (‶ Int ″ ⋆))) (ref (‶ 0 ″ ε))]
       [(_ : (‶ (→ Int Unit) ″ ε))
        (‶ (λ β (x : Int)
             ((~ (begin (r := (((power‶″ [β]) 3) (‶ x ″ β)))
                       (‶ () ″ ε)))
              :: Unit)) ″ ε)])
  (! r))
