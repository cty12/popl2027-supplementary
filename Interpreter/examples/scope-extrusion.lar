(‶ (λ α (x : Int)
     ((~ (let* ([(r : (Ref (‶ Int ″ ⋆))) (ref (‶ 0 ″ ε))]
                [(_ : ⋆) (‶ (λ β (y : Int)
                              ((~ (begin (r := (‶ y ″ β))
                                         (‶ () ″ ε)))
                               :: Unit)) ″ ε)])
           (! r)))
         :: Int)) ″ ε)
