(let* ([(atomic? : (∀̇ (_ <: β <: _) (→ (‶ Int ″ β) Bool)))
        (Λ (_ <: β <: _) (λ (c : (‶ Int ″ β)) #t))]
       [(let-complex : (∀̇ (_ <: α <: _)
                          (→ (‶ Int ″ α)
                             (→ (∀̇ (_ <: γ <: _) (→ (‶ Int ″ γ) (‶ Int ″ γ)))
                                (‶ Int ″ α)))))
        (Λ (_ <: α <: _)
         (λ (m : (‶ Int ″ α))
           (λ (body : (∀̇ (_ <: γ <: _) (→ (‶ Int ″ γ) (‶ Int ″ γ))))
             (if ((atomic? [α]) m)
                 ((body [α]) m)
                 (‶ (let* ([(x : γ Int) ((~ m) :: Int)])
                      ((~ ((body [γ]) (‶ x ″ γ))) :: Int)) ″ α)))))])
  (((let-complex [ε]) (‶ 1 ″ ε))
    ;; body
    (Λ (_ <: β <: _)
       (λ (c : (‶ Int ″ β))
         (‶ (let* ([(x : δ Int) 1]) (('+ ((~ c) :: Int)) 1)) ″ β)))))
