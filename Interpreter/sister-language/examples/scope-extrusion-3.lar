(‶ (λ α (x : Int)
     ((~ (let* ([(r : (Ref (‶ Int ″ α))) (ref (‶ 0 ″ ε))]
                [(_ : (‶ (→ Int Unit) ″ ε))
                 (‶ (λ β (y : Int)
                      ((~ (begin (r := (‶ y ″ β))
                                 (‶ () ″ ε)))
                       :: Unit)) ″ ε)])
           (! r)))
      :: Int)) ″ ε)
