(‶ (((λ α (x : Int)
       (λ β (y : Int)
         ((~
            (((Λ (α <: δ <: β)
                (λ (z : (‶ Int ″ δ))
                  (‶ (('+ ((~ z) :: Int))
                          ((~ (‶ x ″ δ)) :: Int)) ″ β)))
              [β]) (‶ y ″ β)))
          :: Int))) 1) 2) ″ ε)

