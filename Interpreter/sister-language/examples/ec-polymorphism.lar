(let* ([(u : (∀̇ (_ <: δ <: _) (→ (‶ Int ″ δ) (‶ Int ″ δ))))
        (Λ (_ <: δ <: _)
           (λ (z : (‶ Int ″ δ))
             (‶ (('+ 1) (~ z)) ″ δ)))]
       [(f : (‶ (→ Int Int) ″ ε))
        (‶ (λ α (z : Int) (('+ (~ ((u [ α ]) (‶ z ″ α)))) z)) ″ ε)]
       [(f^ : (‶ (→ Int Int) ″ ε))
        (‶ (λ β (w : Int) (('+ (~ ((u [ β ]) (‶ w ″ β)))) w)) ″ ε)])
  42)
