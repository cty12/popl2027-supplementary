(let* ([(eta : (∀̇ (_ <: γ <: _)
                 (→ (∀̇ (γ <: β <: _)
                      (→ (‶ Int ″ β) (‶ Int ″ β)))
                    (‶ (→ Int Int) ″ γ))))
        (Λ (_ <: γ <: _)
          (λ (f : (∀̇ (γ <: β <: _) (→ (‶ Int ″ β) (‶ Int ″ β))))
            (‶ (λ α (x : Int)
                 ((~ ((f [α]) (‶ x ″ α))) :: Int)) ″ γ)))])
  (‶ ((λ γ (u : Int)
         (((~ ((eta [γ])
               (Λ (γ <: β <: _)
                 (λ (z : (‶ Int ″ β))
                   (‶ (('+ u) ((~ z) :: Int)) ″ β))))) ;; need γ <: β here
           :: (→ Int Int))
          40)) 2) ″ ε))
